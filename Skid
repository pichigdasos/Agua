    local function WatchKiller(Killer)
        if WatchConns[Killer] or not Killer:IsA("Model") then return end
        local List = {}
        WatchConns[Killer] = List
        local Humanoid = Killer:FindFirstChildOfClass("Humanoid") or Killer:WaitForChild("Humanoid", 5)
        local Animator = Humanoid and (Humanoid:FindFirstChildOfClass("Animator") or Humanoid:WaitForChild("Animator", 3))
