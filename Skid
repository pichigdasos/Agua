local PlasmaBeamState = { Enabled = false, Prediction = 0.12, Offset = 0, RF = nil, Original = nil, Installed = false, MotionData = {}, TargetType = "Survivor" }

local function PlasmaGetTarget()
    local char = LocalPlayer.Character
    if not char then return nil end
    local myHRP = char:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local targetType = PlasmaBeamState.TargetType or "Survivor"
    local folder = (targetType == "Killer") and KillersFolder or SurvivorsFolder
    if not folder then return nil end
    local best, bestDist = nil, math.huge
    for _, model in ipairs(folder:GetChildren()) do
        if model ~= char then
            local hrp = model:FindFirstChild("HumanoidRootPart")
            local hum = model:FindFirstChildOfClass("Humanoid")
            if hrp and (not hum or hum.Health > 0) then
                local d = (hrp.Position - myHRP.Position).Magnitude
                if d < bestDist then bestDist = d; best = hrp end
            end
        end
    end
    return best
end

local function PlasmaGetVelocity(hrp)
    local now = tick()
    local pos = hrp.Position
    local data = PlasmaBeamState.MotionData[hrp]
    if not data then
        PlasmaBeamState.MotionData[hrp] = { LastPos = pos, LastTime = now, Vel = Vector3.zero }
        return Vector3.zero
    end
    local dt = now - data.LastTime
    if dt > 0 then
        data.Vel = (pos - data.LastPos) / dt
        data.LastPos = pos
        data.LastTime = now
    end
    return data.Vel
end

local function PlasmaInstall()
    if PlasmaBeamState.Installed then return end
    local ok, rf = pcall(function()
        return ReplicatedStorage:WaitForChild("Modules", 10)
            :WaitForChild("Network", 10)
            :WaitForChild("Network", 10)
            :WaitForChild("RemoteFunction", 10)
    end)
    if not ok or not rf then return end
    PlasmaBeamState.RF = rf
    if typeof(getcallbackvalue) == "function" then
        PlasmaBeamState.Original = getcallbackvalue(rf, "OnClientInvoke")
    else
        PlasmaBeamState.Original = rf.OnClientInvoke
    end
    rf.OnClientInvoke = function(reqName, ...)
        if reqName == "GetMousePosition" and PlasmaBeamState.Enabled then
            local target = PlasmaGetTarget()
            if target then
                local vel = PlasmaGetVelocity(target)
                return target.Position + vel * PlasmaBeamState.Prediction + Vector3.new(0, PlasmaBeamState.Offset, 0)
            end
        end
        if PlasmaBeamState.Original then
            return PlasmaBeamState.Original(reqName, ...)
        end
    end
    PlasmaBeamState.Installed = true
end

task.spawn(function() pcall(PlasmaInstall) end)

