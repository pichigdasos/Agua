local function CandyCheck(Object)
    if Object:IsA("ProximityPrompt") then
        if CandyMatches(Object.ObjectText) or CandyMatches(Object.ActionText) then
            local Parent = Object.Parent
            if Parent and (Parent:IsA("BasePart") or Parent:IsA("Model")) then
                CandyAdd(Parent)
            end
        end
    elseif (Object:IsA("Model") or Object:IsA("BasePart")) and not Object:IsA("Terrain") and CandyMatches(Object.Name) then
        CandyAdd(Object)
    end
