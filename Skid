local CandyHoldTime = 1.5
local CandyRevisit = 20
local CandyFarmRunning = false
local CandyLegitRunning = false

local function CandyMatches(Text)
    Text = string.lower(tostring(Text or ""))
    if Text == "" then return false end
    for _, Word in ipairs(CandyKeywords) do
        if string.find(Text, Word, 1, true) then return true end
    end
    return false
end

local function CandyInMatch(Object)
    local Map = workspace:FindFirstChild("Map")
    local Ingame = Map and Map:FindFirstChild("Ingame")
    return Ingame ~= nil and Object:IsDescendantOf(Ingame)
end

local function CandyIsLiving(Object)
    local Current = Object
    while Current and Current ~= workspace do
        if Current:IsA("Model") and Current:FindFirstChildOfClass("Humanoid") then
            return true
        end
        Current = Current.Parent
    end
    return false
end

local function CandyGetPart(Target)
    if Target:IsA("BasePart") then return Target end
    if Target:IsA("Model") then
        return Target.PrimaryPart or Target:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function CandyGetRoot()
    local Character = LocalPlayer.Character
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function CandyGetHumanoid()
    local Character = LocalPlayer.Character
    return Character and Character:FindFirstChildOfClass("Humanoid")
end

local function CandyRemove(Target)
    local Entry = CandyTracked[Target]
    if not Entry then return end
    CandyTracked[Target] = nil
    CandyDone[Target] = nil
    if Entry.Link then Entry.Link:Disconnect() end
    if Entry.Highlight then Entry.Highlight:Destroy() end
    if Entry.Billboard then Entry.Billboard:Destroy() end
end

local function CandyAdd(Target)
    if CandyTracked[Target] or not CandyInMatch(Target) or CandyIsLiving(Target) then return end
    local Ancestor = Target.Parent
    while Ancestor and Ancestor ~= workspace do
        if CandyTracked[Ancestor] then return end
        Ancestor = Ancestor.Parent
    end
    local Part = CandyGetPart(Target)
    if not Part then return end

    local Highlight = Instance.new("Highlight")
    Highlight.FillColor = CandyAccent
    Highlight.FillTransparency = 0.5
    Highlight.OutlineColor = Color3.new(1, 1, 1)
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Enabled = State.CandyESP
