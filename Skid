local function AHGetCharacterLevel(character)
    if not character then return 0 end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart") or (humanoid and humanoid.RootPart)
    if not rootPart or not AutoHatchet.levels then return 0 end
    local level = 0
    for _, attachment in ipairs(AutoHatchet.levels:GetChildren()) do
        if attachment:IsA("Attachment") then
            local number = tonumber(attachment.Name:match("%d+"))
            if number and number > level then
                local matches = true
                for _, effect in ipairs(attachment:GetChildren()) do
                    if not rootPart:FindFirstChild(effect.Name) then
                        matches = false
                        break
                    end
                end
                if matches then level = number end
            end
        end
    end
    return level
end

local function AHGetClosestKiller(distance)
    distance = distance or AutoHatchet.range
    local selectedKiller
    local dist = distance
    if not KillersFolder or not LocalRoot then return nil, dist end
    for _, v in ipairs(KillersFolder:GetChildren()) do
        if Players:GetPlayerFromCharacter(v) then
            local hrp = v:FindFirstChild("HumanoidRootPart")
            local hum = v:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - LocalRoot.Position).Magnitude
                if d < dist then
                    dist = d
                    selectedKiller = v
                end
            end
        end
    end
    return selectedKiller, dist
end

local function AHRunLoop()
    if AutoHatchet.loopStarted then return end
    AutoHatchet.loopStarted = true
    task.spawn(function()
        while not AutoHatchet.unloaded do
            task.wait(0.05)
            if not AutoHatchet.enabled then continue end
            if not LocalHumanoid or not LocalCharacter then continue end
            if AutoHatchet.running then continue end
            if not LocalCharacter.Parent or LocalCharacter.Parent.Name ~= "Survivors" then continue end
            local charName = (LocalCharacter:GetAttribute("CharacterName") or LocalCharacter.Name or ""):lower()
            if not charName:find("jane") then continue end
            local abilityContainer = PlayerGui:FindFirstChild("MainUI") and PlayerGui.MainUI:FindFirstChild("AbilityContainer")
            if not abilityContainer then continue end
            local ability
            for _, v in ipairs(abilityContainer:GetChildren()) do
                if table.find(AutoHatchet.abilityNames, v.Name) then ability = v break end
            end
            if not ability then continue end
            local clipping = ability:FindFirstChild("Clipping")
            if not clipping or clipping.Visible == false or clipping.Size.Y.Scale ~= 1 then continue end
            local closestKiller = AHGetClosestKiller(AutoHatchet.range)
            if not closestKiller then continue end
            if AHGetCharacterLevel(closestKiller) < AutoHatchet.levelThreshold then continue end
            local kHrp = closestKiller:FindFirstChild("HumanoidRootPart")
            if not kHrp then continue end
            if kHrp:FindFirstChild("InvincibleFX") then continue end
            AutoHatchet.running = true
            pcall(function() LocalCharacter:SetAttribute("DoingActionPower", true) end)
            local FireSignalFn = typeof(firesignal) == "function" and firesignal or nil
            if FireSignalFn and ability then
                pcall(function()
                    FireSignalFn(ability.MouseButton1Down)
                    FireSignalFn(ability.MouseButton1Click)
                end)
            elseif Remote then
                for _, v in ipairs(AutoHatchet.abilityNames) do
                    if OfficialGame then
                        Remote:FireServer("UseActorAbility", {v})
                    else
                        Remote:FireServer("UseActorAbility", v)
                        Remote:FireServer("UseActorAbility", {v})
                    end
                end
            end
            local camConn
            local selectedVelocity
            camConn = RunService.RenderStepped:Connect(function()
                local ck = AHGetClosestKiller()
                if not ck then return end
                local ckHrp = ck:FindFirstChild("HumanoidRootPart")
                if not ckHrp then return end
                local killerRootPos = ckHrp.Position
                local selectedPosition = Vector3.new(killerRootPos.X, LocalRoot.Position.Y, killerRootPos.Z)
