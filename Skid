local AntiSlowProtectors = setmetatable({}, { __mode = "k" })
local function ProtectCharacterFromSlow(char)
    if AntiSlowProtectors[char] then return end
    AntiSlowProtectors[char] = true
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if State.AntiSlowness and hum.WalkSpeed < 16 and hum.WalkSpeed > 0 then
            hum.WalkSpeed = 16
        end
    end)
    hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if State.AntiSlowness and hum.JumpPower < 50 and hum.JumpPower > 0 then
            hum.JumpPower = 50
        end
    end)
    hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
        if State.AntiSlowness and hum.PlatformStand then
            hum.PlatformStand = false
        end
    end)
    hum.StateChanged:Connect(function(_, new)
        if State.AntiSlowness and (new == Enum.HumanoidStateType.Physics or new == Enum.HumanoidStateType.FallingDown or new == Enum.HumanoidStateType.Ragdoll) then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)
end

local function CheckSlowness(ValueInstance)
    if not State.AntiSlowness or not ValueInstance or not ValueInstance:IsA("NumberValue") then return end
    local Name = ValueInstance.Name
    if Name == "Sprinting" or Name:lower() == "emoting" then return end
    if Name == "DirectionalMovement" or Name == "FixingGenerator" or Name:upper() == "ENRAGED" then
        if ValueInstance.Value < 1 then ValueInstance.Value = 1 end
        ValueInstance:GetPropertyChangedSignal("Value"):Connect(function()
            if ValueInstance.Value < 1 and State.AntiSlowness then ValueInstance.Value = 1 end
        end)
    elseif ValueInstance.Value > 0.03 and ValueInstance.Value < 1 then
        ValueInstance:Destroy()
    else
        ValueInstance:GetPropertyChangedSignal("Value"):Connect(function()
            if State.AntiSlowness and ValueInstance.Value > 0.03 and ValueInstance.Value < 1 then ValueInstance:Destroy() end
        end)
    end
end

local function SetAntiSlowness(Enabled)
    if Enabled and SpeedMultipliers then
        for _, Child in SpeedMultipliers:GetChildren() do CheckSlowness(Child) end
    end
    if Enabled then
