local function HookAnimations()
    if AnimationConnection then AnimationConnection:Disconnect(); AnimationConnection = nil end
    StopAiming()
    RefreshAimAnimator()
    if not LocalHumanoid then return end
    AnimationConnection = LocalHumanoid.AnimationPlayed:Connect(function(Track)
        local Animation = Track.Animation
        if not Animation then return end
        local Id = Animation.AnimationId
        if PunchAnimations[Id] and State.PunchAimbot then
            if AimLastTrigger[Track] and os.clock() - AimLastTrigger[Track] < PunchAimCooldown then return end
            local TimePos = 0
            pcall(function() TimePos = Track.TimePosition or 0 end)
            if TimePos <= 0.12 then
                AimLastTrigger[Track] = os.clock()
                local Target = GetKillerAimTarget()
                if Target then RunAimLock(Target) end
                task.delay(PunchAimCooldown, function() AimLastTrigger[Track] = nil end)
            end
        end
    end)
end

