local ConfigCache = setmetatable({}, { __mode = "k" })

local function CachedRequire(Module)
    local Entry = ConfigCache[Module]
    if not Entry then
        local Ok, Data = pcall(require, Module)
        Entry = { Ok, Data }
        ConfigCache[Module] = Entry
    end
    return Entry[1], Entry[2]
end

