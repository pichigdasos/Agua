    function RefreshBlockZone()
        if State.BlockMethod == "Circle" then
            CreateCircleVisual()
        else
            RemoveCircleVisual()
        end
        if not State.ShowRange then StopZone(); return end
        if ZoneConn and ZoneBoxPart and ZoneBoxPart.Parent then return end
        if ZoneConn then ZoneConn:Disconnect(); ZoneConn = nil end
        for _, P in ipairs(ZoneParts) do pcall(function() P:Destroy() end) end
        table.clear(ZoneParts)
        if ZoneBoxPart then pcall(function() ZoneBoxPart:Destroy() end); ZoneBoxPart = nil end
        ZoneBoxPart = MakeZonePart("FluxZoneBox")
        ZoneBoxPart.Material = Enum.Material.ForceField
        ZoneBoxPart.Color = Color3.fromRGB(120, 200, 255)
        for _ = 1, ArcSteps + 3 do table.insert(ZoneParts, MakeZonePart("FluxZoneLine")) end
        ZoneConn = RunService.Heartbeat:Connect(function()
            if not ZoneBoxPart or not ZoneBoxPart.Parent or #ZoneParts == 0 or not ZoneParts[1] or not ZoneParts[1].Parent then
                if ZoneConn then ZoneConn:Disconnect(); ZoneConn = nil end
                for _, P in ipairs(ZoneParts) do pcall(function() P:Destroy() end) end
                table.clear(ZoneParts)
                if ZoneBoxPart then pcall(function() ZoneBoxPart:Destroy() end) end
                ZoneBoxPart = nil
                if State.ShowRange then
                    task.defer(function()
                        if State.ShowRange and not ZoneConn then
                            pcall(RefreshBlockZone)
                        end
                    end)
                end
                return
            end
            if State.BlockMethod == "Circle" then
                ZoneBoxPart.Transparency = 1
                for _, P in ipairs(ZoneParts) do P.Transparency = 1 end
                return
            end
            local Killer = GetClosestKiller(150)
            local KillerRoot = Killer and Killer:FindFirstChild("HumanoidRootPart")
            if not KillerRoot then
                ZoneBoxPart.Transparency = 1
                for _, P in ipairs(ZoneParts) do P.Transparency = 1 end
                return
            end
            if State.BlockMethod == "Cone" then
                ZoneBoxPart.Transparency = 1
                local Apex = Vector3.new(KillerRoot.Position.X, KillerRoot.Position.Y - 2.8, KillerRoot.Position.Z)
                local Look = FlatLook(KillerRoot)
                if Look.Magnitude < 0.01 then Look = Vector3.new(0, 0, -1) end
                Look = Look.Unit
                local Length = State.ConeLength or ConeReach
                local Half = math.rad((State.ConeWidth or 10) / 2)
                local Points = {}
                for I = 0, ArcSteps do
                    local Angle = -Half + (2 * Half) * I / ArcSteps
                    table.insert(Points, Apex + CFrame.Angles(0, Angle, 0):VectorToWorldSpace(Look) * Length)
                end
                SetZoneLine(ZoneParts[1], Apex, Points[1])
                SetZoneLine(ZoneParts[2], Apex, Points[#Points])
                for I = 1, ArcSteps do
                    SetZoneLine(ZoneParts[2 + I], Points[I], Points[I + 1])
                end
                ZoneParts[ArcSteps + 3].Transparency = 1
            else
                for _, P in ipairs(ZoneParts) do P.Transparency = 1 end
                local CF, Size = GetHitboxCF(KillerRoot, Killer)
                ZoneBoxPart.Size = Size
                ZoneBoxPart.CFrame = CF
                ZoneBoxPart.Transparency = 0.8
            end
        end)
    end

    table.insert(CharacterCallbacks, function()
        task.wait(1)
        if State.ShowRange then
            if not ZoneConn or not ZoneBoxPart or not ZoneBoxPart.Parent then
                if ZoneConn then ZoneConn:Disconnect(); ZoneConn = nil end
                for _, P in ipairs(ZoneParts) do pcall(function() P:Destroy() end) end
                table.clear(ZoneParts)
                if ZoneBoxPart then pcall(function() ZoneBoxPart:Destroy() end); ZoneBoxPart = nil end
                pcall(RefreshBlockZone)
            end
        end
    end)
end

