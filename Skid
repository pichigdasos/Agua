local function BeginDragIntoKiller(Killer)
    if DragDebounce then return end
    if not Killer or not Killer.Parent then return end
    local Character = LocalCharacter
    if not Character then return end
    local Root = Character:FindFirstChild("HumanoidRootPart")
    local Hum = Character:FindFirstChildOfClass("Humanoid")
    if not Root or not Hum then return end
    local TargetRoot = Killer:FindFirstChild("HumanoidRootPart")
    if not TargetRoot then return end
    DragDebounce = true
    local OldWalk = Hum.WalkSpeed
    local OldJump = Hum.JumpPower
    local OldPlatform = Hum.PlatformStand
    Hum.WalkSpeed = 0
    Hum.JumpPower = 0
    Hum.PlatformStand = false
    local BV = Instance.new("BodyVelocity")
    BV.MaxForce = Vector3.new(1e5, 0, 1e5)
    BV.Velocity = Vector3.zero
    BV.Parent = Root
    local Conn
    Conn = RunService.Heartbeat:Connect(function()
        if not DragDebounce then
            Conn:Disconnect()
            if BV and BV.Parent then pcall(function() BV:Destroy() end) end
            Hum.WalkSpeed = OldWalk
            Hum.JumpPower = OldJump
            Hum.PlatformStand = OldPlatform
            return
        end
        if not (Character and Character.Parent) or not (Killer and Killer.Parent) then
            DragDebounce = false
            return
        end
        TargetRoot = Killer:FindFirstChild("HumanoidRootPart")
        if not TargetRoot then DragDebounce = false; return end
        local ToTarget = TargetRoot.Position - Root.Position
        local Horiz = Vector3.new(ToTarget.X, 0, ToTarget.Z)
        if Horiz.Magnitude > 0.01 then
            local Dir = Horiz.Unit
            local Speed = State.HitboxDragSpeed or 5.6
            BV.Velocity = Vector3.new(Dir.X * Speed, BV.Velocity.Y, Dir.Z * Speed)
        end
        if ToTarget.Magnitude <= 2 then DragDebounce = false end
    end)
