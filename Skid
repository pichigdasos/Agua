local function GetKillerAimTarget()
    if not KillersFolder or not LocalRoot then return nil end
    local Camera = workspace.CurrentCamera
    local Best, BestRoot, BestScore = nil, nil, math.huge
    for _, Killer in KillersFolder:GetChildren() do
        local Hum = Killer:FindFirstChildOfClass("Humanoid")
        local Root = Killer:FindFirstChild("HumanoidRootPart")
        if Hum and Root and Hum.Health > 0 then
            local Dist = (LocalRoot.Position - Root.Position).Magnitude
            if Dist <= 70 then
                local Score = Dist
                if Camera then
                    local _, OnScreen = Camera:WorldToViewportPoint(Root.Position)
                    if OnScreen then Score = Dist * 0.55 end
                end
                if Score < BestScore then Best = Killer; BestRoot = Root; BestScore = Score end
            end
        end
    end
    if BestRoot then return BestRoot end
    for _, Player in Players:GetPlayers() do
        if Player ~= LocalPlayer and Player.Character then
            local Hum = Player.Character:FindFirstChildOfClass("Humanoid")
            local Root = Player.Character:FindFirstChild("HumanoidRootPart")
            if Hum and Root and Hum.Health > 0 and Hum.MaxHealth > 500 then
                local Dist = (LocalRoot.Position - Root.Position).Magnitude
                if Dist < 40 and Dist < BestScore then BestRoot = Root; BestScore = Dist end
            end
        end
    end
    return BestRoot
end

local function GetPredictedAimPosition(Target)
    if not Target then return nil end
    local PredictValue = State.PunchAimPrediction or 0.15
    local LeadTime = 0.08 + PredictValue + GetAimPing() * 0.4
    return Target.Position + Target.AssemblyLinearVelocity * LeadTime
end

local function RunAimLock(Target)
    StopAiming()
    if not Target then return end
    local StartedAt = os.clock()
    local Character = LocalCharacter
    local Root = LocalRoot
    if not Character or not Root then return end
    local Hum = Character:FindFirstChildOfClass("Humanoid")
    if Hum then pcall(function() Hum.AutoRotate = false end) end
    AimConnection = RunService.RenderStepped:Connect(function()
        local MyRoot = LocalRoot
        local Char = LocalCharacter
        if not State.PunchAimbot or not MyRoot or not Char or not Target.Parent then
            StopAiming()
            if Hum then pcall(function() Hum.AutoRotate = true end) end
            return
        end
        if os.clock() - StartedAt > PunchAimWindow then
            StopAiming()
            if Hum then pcall(function() Hum.AutoRotate = true end) end
            return
        end
        local Predicted = GetPredictedAimPosition(Target)
        if not Predicted then return end
        if State.PunchAimCharLock ~= false then
            local ToTarget = Vector3.new(Predicted.X - MyRoot.Position.X, 0, Predicted.Z - MyRoot.Position.Z)
            if ToTarget.Magnitude > 0.01 then
                MyRoot.CFrame = CFrame.lookAt(MyRoot.Position, MyRoot.Position + ToTarget.Unit)
            end
        end
        if State.PunchAimCamLock ~= false then
            local Camera = workspace.CurrentCamera
            if Camera then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, Predicted)
            end
        end
    end)
end

