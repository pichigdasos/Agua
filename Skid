    local best, bestD = nil, AntiBackstab.range
    for _, model in ipairs(sv:GetChildren()) do
        if AbsTarget(model) then
            local hrp = model:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - pos).Magnitude
                if d < bestD then best, bestD = model, d end
            end
        end
    end
    return best
end

local function AbsTrigger(target)
    if not AntiBackstab.enabled or AntiBackstab.locked then return end
    if not AbsIsKiller() then return end
    local ch = LocalPlayer.Character
    local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return end
    local model = target
    if not AbsTarget(model) then
        model = AbsFindNearestModel(myRoot.Position)
    end
    if not AbsTarget(model) or model == ch then return end
    local ttRoot = model:FindFirstChild("HumanoidRootPart")
    if not ttRoot or not ttRoot.Parent then return end
    if (myRoot.Position - ttRoot.Position).Magnitude > AntiBackstab.range then return end
    local turn = { hum = hum, char = ch }
    AntiBackstab.turn = turn
    AntiBackstab.locked = true
    AntiBackstab.hits += 1
    AbsLabel(true)
    turn.thread = coroutine.create(function()
        pcall(function()
            if hum and hum.Parent then hum.AutoRotate = false end
            local deadline = os.clock() + AntiBackstab.duration
            local hp0 = hum and hum.Health
            while os.clock() < deadline and AntiBackstab.enabled do
                if AntiBackstab.turn ~= turn or LocalPlayer.Character ~= ch or not AbsIsKiller() or not AbsTarget(model) then break end
                local ch2 = LocalPlayer.Character
                local r2 = ch2 and ch2:FindFirstChild("HumanoidRootPart")
                local hum2 = ch2 and ch2:FindFirstChildOfClass("Humanoid")
                if hum2 ~= hum then break end
                if hp0 and hum2 and hum2.Health < hp0 - 0.5 then break end
                if not r2 or not ttRoot.Parent then break end
                local p2 = r2.Position
                local t2 = ttRoot.Position
                local flat = Vector3.new(t2.X - p2.X, 0, t2.Z - p2.Z)
                if flat.Magnitude < 0.05 then break end
                r2.CFrame = CFrame.lookAt(p2, Vector3.new(t2.X, p2.Y, t2.Z))
                RunService.RenderStepped:Wait()
            end
        end)
        if AntiBackstab.turn == turn then AbsReleaseTurn() end
    end)
    task.spawn(turn.thread)
end

local function AbsOwned(model, owner, session)
    return session and session.live and AbsTarget(model) and AntiBackstab.animConns[model] == owner
end

local function AbsCheckSound(snd, model, owner, session)
    if not AbsOwned(model, owner, session) or not snd:IsDescendantOf(model) then return end
    local ok, id = pcall(function() return snd.SoundId:match("%d+") end)
    if ok and id and AntiBackstab.absSoundIds[id] then AbsTrigger(model) end
end

local function AbsBindSound(snd, model, owner, session)
    if not AbsOwned(model, owner, session) then return end
    if not (snd and snd:IsA("Sound") and snd:IsDescendantOf(model)) or AntiBackstab.soundConns[snd] then return end
    local cId, cPlay, cPlaying, cAnc
    local entry = { owner = owner }
    local function dropSnd()
        if AntiBackstab.soundConns[snd] == entry then AntiBackstab.soundConns[snd] = nil end
        if cId then pcall(function() cId:Disconnect() end) cId = nil end
        if cPlay then pcall(function() cPlay:Disconnect() end) cPlay = nil end
        if cPlaying then pcall(function() cPlaying:Disconnect() end) cPlaying = nil end
        if cAnc then pcall(function() cAnc:Disconnect() end) cAnc = nil end
    end
    entry.Disconnect = dropSnd
    AntiBackstab.soundConns[snd] = entry
    cId = snd:GetPropertyChangedSignal("SoundId"):Connect(function()
        if snd.IsPlaying then AbsCheckSound(snd, model, owner, session) end
    end)
    cPlay = snd.Played:Connect(function() AbsCheckSound(snd, model, owner, session) end)
    cPlaying = snd:GetPropertyChangedSignal("IsPlaying"):Connect(function()
        if snd.IsPlaying then AbsCheckSound(snd, model, owner, session) end
    end)
    cAnc = snd.AncestryChanged:Connect(function()
        if not snd:IsDescendantOf(model) then dropSnd() end
    end)
    if snd.IsPlaying then AbsCheckSound(snd, model, owner, session) end
end

local function AbsScanSounds(model, owner, session)
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("Sound") then AbsBindSound(d, model, owner, session) end
    end
end

local function AbsHookModel(model, session)
    if not (session and session.live) or not AbsTarget(model) then return end
    if AntiBackstab.showRing then AbsRing(model) else AbsRingOff(model) end
    if AntiBackstab.animConns[model] then return end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    local owner = {}
    local cAnim, cDesc, cAnc
    owner.Disconnect = function()
        if AntiBackstab.animConns[model] == owner then AntiBackstab.animConns[model] = nil end
        if cAnim then pcall(function() cAnim:Disconnect() end) cAnim = nil end
        if cDesc then pcall(function() cDesc:Disconnect() end) cDesc = nil end
        if cAnc then pcall(function() cAnc:Disconnect() end) cAnc = nil end
        for _, entry in pairs(AntiBackstab.soundConns) do
            if entry.owner == owner then entry:Disconnect() end
        end
        AbsRingOff(model)
    end
    AntiBackstab.animConns[model] = owner
    cAnim = animator.AnimationPlayed:Connect(function(track)
        if not AbsOwned(model, owner, session) then return end
        local ok, aid = pcall(function() return track.Animation.AnimationId end)
        local num = ok and aid and aid:match("%d+")
        if num and AntiBackstab.absAnimIds[num] then AbsTrigger(model) end
    end)
    cDesc = model.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then task.defer(AbsBindSound, d, model, owner, session) end
    end)
    cAnc = model.AncestryChanged:Connect(function()
        if not AbsTarget(model) then owner:Disconnect() end
    end)
    AbsScanSounds(model, owner, session)
end

local AbsSession = nil
local AbsScanThread = nil
local AbsFolder = nil
local AbsFolderConns = {}

local function AbsDropTargets()
    for _, c in ipairs(AbsFolderConns) do pcall(function() c:Disconnect() end) end
    table.clear(AbsFolderConns)
    AbsFolder = nil
    for _, c in pairs(AntiBackstab.animConns) do pcall(function() c:Disconnect() end) end
    for _, c in pairs(AntiBackstab.soundConns) do pcall(function() c:Disconnect() end) end
end

local function AbsScanTick()
    if not (AbsSession and AbsSession.live) then return end
    local pl = workspace:FindFirstChild("Players")
    local sv = pl and pl:FindFirstChild("Survivors")
    if AbsFolder ~= sv then
        AbsDropTargets()
        AbsRingsClear()
        AbsFolder = sv
        if sv then
            local folderToken = {}
            AbsSession.folderToken = folderToken
            table.insert(AbsFolderConns, sv.ChildAdded:Connect(function(model)
                task.delay(0.15, function()
                    if AbsSession and AbsSession.folderToken == folderToken and model.Parent == sv then
                        pcall(AbsHookModel, model, AbsSession)
                    end
                end)
            end))
            table.insert(AbsFolderConns, sv.ChildRemoved:Connect(function(model)
                if not AbsSession or AbsSession.folderToken ~= folderToken or model.Parent == sv then return end
                local owner = AntiBackstab.animConns[model]
                if owner then owner:Disconnect() end
                AbsRingOff(model)
            end))
        end
    end
    for model, owner in pairs(AntiBackstab.animConns) do
        if not AbsTarget(model) then owner:Disconnect() end
    end
    if sv then
        for _, model in ipairs(sv:GetChildren()) do pcall(AbsHookModel, model, AbsSession) end
    end
    if not AntiBackstab.showRing then
        AbsRingsClear()
    else
        for model, ring in pairs(AntiBackstab.rings) do
            if not AbsTarget(model) or not ring.Parent or not Players:GetPlayerFromCharacter(model) then AbsRingOff(model) end
        end
    end
end

local function AbsStopScan()
    if AbsScanThread then pcall(task.cancel, AbsScanThread) AbsScanThread = nil end
    AbsDropTargets()
    AbsRingsClear()
    AbsReleaseTurn()
    AbsSession = nil
end

local function AbsStartScan()
    if AbsSession and AbsSession.live then return end
    AbsStopScan()
    local session = { live = true, char = LocalPlayer.Character }
    AbsSession = session
    AbsScanThread = task.spawn(function()
        while session.live and AntiBackstab.enabled do
            pcall(AbsScanTick)
            task.wait(1)
        end
        if AbsSession == session then AbsScanThread = nil end
    end)
end

local AbsRoleConn = nil

local function AbsSyncRole()
    if not AntiBackstab.enabled then AbsStopScan(); return end
    if not AbsIsKiller() then AbsStopScan(); return end
    AbsStartScan()
end

local function AbsToggle(Enabled)
    AntiBackstab.enabled = Enabled
    if Enabled then
