local function ProjEnsureMods()
    if ProjectileESP.mod then return true end
    local ok, r1 = pcall(function() return require(game:GetService("ReplicatedStorage").Systems.Player.Game.ProjectileReplication) end)
    if ok and type(r1) == "table" and type(r1.Projectiles) == "table" then ProjectileESP.mod = r1 end
    return ProjectileESP.mod ~= nil
end

local projRayParams = RaycastParams.new()
projRayParams.FilterType = Enum.RaycastFilterType.Exclude
projRayParams.IgnoreWater = true
projRayParams.RespectCanCollide = true

local function ProjLandingOf(p)
    local cf = p.InitialCFrame
    local vel = p.InitialVelocity
    if typeof(cf) ~= "CFrame" or typeof(vel) ~= "Vector3" then return nil end
    local pos = cf.Position
    local g = math.abs(tonumber(p.Gravity) or 0)
    local pf = workspace:FindFirstChild("Players")
    local filter = { ProjEnsureFolder() }
    if pf then table.insert(filter, pf) end
    local myChar = LocalPlayer.Character
    if myChar then table.insert(filter, myChar) end
    projRayParams.FilterDescendantsInstances = filter
    local prev = pos
    local steps = 18
    local maxT = math.clamp(tonumber(p.Lifetime) or 5.5, 4.0, 7.0)
    for i = 1, steps do
        local t = (i / steps) * maxT
        local nxt = pos + vel * t - Vector3.new(0, 0.5 * g * t * t, 0)
        local seg = nxt - prev
        if seg.Magnitude > 0.05 then
            local hit = workspace:Raycast(prev, seg, projRayParams)
            if hit then return hit.Position end
        end
        prev = nxt
    end
    return prev
end

local function ProjPoll()
    if not ProjectileESP.on then return end
    if not ProjEnsureMods() then return end
    local live = ProjectileESP.mod.Projectiles
    if next(live) == nil and next(ProjectileESP.markers) == nil then return end
    local nowP = os.clock()
    for id, entry in pairs(ProjectileESP.markers) do
        if live[id] == nil then
            if type(entry) == "table" and entry.part then pcall(function() entry.part:Destroy() end) end
            ProjectileESP.markers[id] = nil
        elseif type(entry) == "table" then
            local age = nowP - (entry.birth or nowP)
            if age >= ProjectileESP.maxAge then
                if entry.part then pcall(function() entry.part:Destroy() end) end
                ProjectileESP.markers[id] = false
            else
                local ratio = math.clamp(age / ProjectileESP.maxAge, 0, 1)
                local fade = ratio * ratio
                local pt = entry.part
                local ad = entry.ad
                if pt and pt.Parent then
                    pt.Color = ProjectileESP.color
                    pt.Transparency = 0.5 + (0.5 * fade)
                end
                if ad and ad.Parent then
                    ad.Color3 = ProjectileESP.color
                    ad.Transparency = 0.4 + (0.6 * fade)
                end
            end
        end
    end
    for id, p in pairs(live) do
        if ProjectileESP.markers[id] == nil and type(p) == "table" then
            local land = nil
            pcall(function() land = ProjLandingOf(p) end)
            if land then
                local pos = p.InitialCFrame.Position
                local thick = 0.8
                pcall(function()
                    local m = p.Model
                    if m then
                        if m:IsA("Model") then
                            local es = m:GetExtentsSize()
                            thick = math.max(es.X, es.Y)
                        elseif m:IsA("BasePart") then
                            thick = math.max(m.Size.X, m.Size.Y)
                        end
                    end
                end)
                thick = math.clamp(thick, 0.8, 6) * 1.2
                local mag = (land - pos).Magnitude
                local part = Instance.new("Part")
                part.Name = "NP_ProjLine_" .. tostring(id)
                part.Anchored = true
                part.CanCollide = false
                part.CanQuery = false
                part.CanTouch = false
                part.CastShadow = false
                part.Size = Vector3.new(thick, thick, mag)
                part.CFrame = CFrame.lookAt(pos, land) * CFrame.new(0, 0, -mag / 2)
                part.Material = Enum.Material.Neon
                part.Color = ProjectileESP.color
                part.Transparency = 0.5
                pcall(function() part.Parent = ProjEnsureFolder() end)
                local ad = Instance.new("BoxHandleAdornment")
                ad.Size = part.Size
                ad.AlwaysOnTop = true
                ad.ZIndex = 10
                ad.Adornee = part
                ad.CFrame = CFrame.new()
                ad.Color3 = ProjectileESP.color
                ad.Transparency = 0.4
                ad.Parent = part
                ProjectileESP.markers[id] = { part = part, ad = ad, birth = nowP }
            end
        end
    end
end

local function ProjSet(Enabled)
    ProjectileESP.on = Enabled
    if Enabled then
        if not ProjectileESP.conn then
            ProjectileESP.conn = RunService.Heartbeat:Connect(function()
                pcall(ProjPoll)
            end)
        end
    else
        if ProjectileESP.conn then ProjectileESP.conn:Disconnect(); ProjectileESP.conn = nil end
        ProjClearAll()
        if ProjectileESP.folder then pcall(function() ProjectileESP.folder:Destroy() end); ProjectileESP.folder = nil end
    end
end

