                if State.TTDistCheck and not TT_CheckDist(LocalRoot, killer:FindFirstChild("HumanoidRootPart"), State.TTDistCheckStud or 7) then return end
                task.spawn(TT_RunBackstab)
            elseif (id == "89448354637442" or id == "107640065977686") and State.TTDashstab then
                if State.TTDistCheck and not TT_CheckDist(LocalRoot, killer:FindFirstChild("HumanoidRootPart"), State.TTDistCheckStud or 7) then return end
                task.spawn(TT_RunDashstab)
            end
        end)
    end)
end

