            pcall(function() LocalCharacter:SetAttribute("DisableShiftLockMovement", true) end)
            local fovMult = LocalCharacter:FindFirstChild("FOVMultipliers")
            repeat task.wait(0.05) until (fovMult and fovMult:FindFirstChild("HitRegistered")) or workspace.DistributedGameTime > timeout
            if LocalRoot then LocalRoot.Velocity = LocalRoot.Velocity * 0.15 end
            if camConn then camConn:Disconnect() end
            task.wait(0.1)
            pcall(function() LocalCharacter:SetAttribute("DisableShiftLockMovement", false) end)
            task.wait(1.6)
            pcall(function() LocalCharacter:SetAttribute("DoingActionPower", nil) end)
            AutoHatchet.running = false
        end
    end)
end

