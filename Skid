local function CandyTouch(Root, Target)
    if not firetouchinterest then return end
    local Parts = Target:IsA("BasePart") and {Target} or Target:GetDescendants()
    local Count = 0
    for _, Object in ipairs(Parts) do
        if Object:IsA("BasePart") then
            pcall(firetouchinterest, Root, Object, 0)
            pcall(firetouchinterest, Root, Object, 1)
            Count += 1
            if Count >= 6 then break end
        end
    end
end

local function CandyGetPrompts(Target)
    local Prompts = {}
    local Source = Target
    if not Target:FindFirstChildWhichIsA("ProximityPrompt", true) and Target.Parent then
        Source = Target.Parent
    end
    for _, Object in ipairs(Source:GetDescendants()) do
        if Object:IsA("ProximityPrompt") then
            table.insert(Prompts, Object)
        end
    end
    return Prompts
end

local function CandyCollect(Target, Entry)
    local Part = Entry.Part
    local Spot = CFrame.new(Part.Position + Vector3.new(0, 0.5, 0))
    local Prompts = CandyGetPrompts(Target)
    local Limit = os.clock() + CandyHoldTime
    repeat
        local Root = CandyGetRoot()
        if not Root then break end
        Root.CFrame = Spot
        Root.AssemblyLinearVelocity = Vector3.zero
        CandyTouch(Root, Target)
        if fireproximityprompt then
            for _, Prompt in ipairs(Prompts) do
                pcall(fireproximityprompt, Prompt)
            end
        end
        task.wait(0.1)
    until os.clock() >= Limit or not State.CandyFarm or not Part.Parent
end

local function CandyPickTarget()
    local Root = CandyGetRoot()
    if not Root then return nil, nil end
    local Best, BestEntry = nil, nil
    local BestDistance = math.huge
    for Target, Entry in pairs(CandyTracked) do
        local Last = CandyDone[Target]
        if (not Last or os.clock() - Last > CandyRevisit) and Entry.Part.Parent then
            local Distance = (Entry.Part.Position - Root.Position).Magnitude
            if Distance < BestDistance then
                Best = Target
                BestEntry = Entry
                BestDistance = Distance
            end
        end
    end
    return Best, BestEntry
end

local function CandyFarmLoop()
    if CandyFarmRunning then return end
    CandyFarmRunning = true
    while State.CandyFarm do
        local Best, BestEntry = CandyPickTarget()
        if Best then
            CandyDone[Best] = os.clock()
            CandyCollect(Best, BestEntry)
        else
            task.wait(0.3)
        end
    end
    CandyFarmRunning = false
end

local function CandyFlat(A, B)
    return Vector3.new(A.X - B.X, 0, A.Z - B.Z).Magnitude
end

local function CandyGoTo(Position, Humanoid, Timeout)
    local Start = os.clock()
    Humanoid:MoveTo(Position)
    while State.CandyLegitFarm and os.clock() - Start <= Timeout do
        task.wait(0.05)
        local Root = CandyGetRoot()
        if not Root then return false end
        if CandyFlat(Root.Position, Position) <= 3 then return true end
    end
    return false
end

local function CandyWalkTo(Target, Entry)
    local Part = Entry.Part
    local Path = PathfindingService:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true})
    local Limit = os.clock() + 30
    local BestDistance = math.huge
    local Stuck = 0

    while State.CandyLegitFarm and Part.Parent and os.clock() < Limit do
        local Root = CandyGetRoot()
        local Humanoid = CandyGetHumanoid()
        if not Root or not Humanoid or Humanoid.Health <= 0 then return end
        local Distance = CandyFlat(Root.Position, Part.Position)
        if Distance <= 4 then break end
        if Distance < BestDistance - 1 then
            BestDistance = Distance
            Stuck = 0
        else
            Stuck += 1
            if Stuck >= 4 then return end
        end
        local Ok = pcall(function()
            Path:ComputeAsync(Root.Position, Part.Position)
        end)
        if Ok and Path.Status == Enum.PathStatus.Success then
            local Waypoints = Path:GetWaypoints()
            for Index = 2, math.min(#Waypoints, 6) do
                if not State.CandyLegitFarm then return end
                local Point = Waypoints[Index]
                if Point.Action == Enum.PathWaypointAction.Jump then
                    Humanoid.Jump = true
                end
                CandyGoTo(Point.Position, Humanoid, 1.5)
            end
        else
            CandyGoTo(Part.Position, Humanoid, 1)
        end
    end

    local Prompts = CandyGetPrompts(Target)
    local Limit2 = os.clock() + 1
    while State.CandyLegitFarm and Part.Parent and os.clock() < Limit2 do
        local Humanoid = CandyGetHumanoid()
        if not Humanoid then return end
        Humanoid:MoveTo(Part.Position)
        if fireproximityprompt then
            for _, Prompt in ipairs(Prompts) do
                pcall(fireproximityprompt, Prompt)
            end
        end
        task.wait(0.1)
    end
end

local function CandyLegitLoop()
    if CandyLegitRunning then return end
    CandyLegitRunning = true
    while State.CandyLegitFarm do
        local Best, BestEntry = CandyPickTarget()
        if Best then
            CandyDone[Best] = os.clock()
            CandyWalkTo(Best, BestEntry)
        else
            task.wait(0.3)
        end
    end
    CandyLegitRunning = false
end

